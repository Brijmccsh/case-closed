{
  "expo": {
    "name": "Case Closed",
    "slug": "case-closed",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "caseclosed",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#F6F3EC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.caseclosed.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.caseclosed.app",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mobile.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EC",
          "dark": {
            "image": "./assets/logo-mobile-dark.png",
            "backgroundColor": "#0A1628"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
